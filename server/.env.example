# ─── Database ──────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/condove?retryWrites=true&w=majority

# ─── JWT / Auth ────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=24h

# ─── Firebase Admin (para enviar notificaciones push desde backend) ───────
# Obtener en: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ─── Redis (Bull Queue) ───────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── SendGrid (Emails) ────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxx
SENDGRID_SENDER_EMAIL=noreply@condove.com
CLIENT_URL=https://app.condove.com

# ─── Nómina (Payroll) ──────────────────────────────────────────────────────
# BCV API para tasa de cambio oficial
BCV_API_URL=https://www.bcv.org.ve
BCV_API_KEY=
# Proveedor de tasa de cambio: 'bcv' | 'manual' | 'parallel'
EXCHANGE_RATE_PROVIDER=bcv
# Tasa de cambio manual (fallback si BCV no disponible) - VES por USD
MANUAL_EXCHANGE_RATE_VES=36.0
# Concurrencia del worker de nómina (jobs paralelos)
PAYROLL_WORKER_CONCURRENCY=5

# ─── CORS / Origins ───────────────────────────────────────────────────────
# Regex de dominios permitidos (Vercel + custom domains)
CORS_ORIGIN_REGEX="^https://.*\\.vercel\\.app$|^https://app\\.condove\\.com$|^https://app\\.condominiosvenezuela\\.com$"

# ─── Server ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production