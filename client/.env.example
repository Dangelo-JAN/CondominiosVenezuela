# ─── Firebase (Push Notifications) ─────────────────────────────────────────
# Obtener en: Firebase Console → Project Settings → General → Your apps → Web app
# Requeridas para producción (Vercel/Render) — sin estas, push notifications NO funcionan
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_PROJECT_ID=your-project-id-here
VITE_FIREBASE_APP_ID=your-app-id-here

# ─── API Base URL ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3001/api/v1

# ─── Otras (opcionales) ────────────────────────────────────────────────────
# VITE_SENTRY_DSN=
# VITE_GA_ID=